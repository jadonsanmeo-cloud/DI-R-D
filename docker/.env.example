API_PORT=8036

OPENROUTER_API_KEY=
# Must match AXIOM DATA_INTELLIGENCE_API_TOKEN.
RUNTIME_SERVICE_TOKEN=
GEN_REPORT_API_URL=http://host.docker.internal:8011

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT="data-intelligence"
