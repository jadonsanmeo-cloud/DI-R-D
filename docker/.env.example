API_PORT=8036

POSTGRES_PASSWORD=replace-with-a-long-random-password

OPENROUTER_API_KEY=replace-with-provider-key
# Client credential for calling AXIOM Sandbox Service through its gateway.
SANDBOX_TOKEN=replace-with-axiom-sandbox-token

# Runtime configuration
MODEL_CONFIG_PATH=configs/proxy-openrouter.toml
DATA_CORPUS_ROOT=.
# The SDK calls AXIOM Sandbox Service; that service owns runtime resource limits.
REPORT_FORCE_CODE_AGENT=false

# AXIOM Memory Platform recall. Completed-turn capture is owned upstream.
MEMORY_ENABLED=true
MEMORY_SERVICE_URL=http://host.docker.internal:8005
MEMORY_TENANT_ID=test-org
MEMORY_DEFAULT_USER_ID=local-dev-user
MEMORY_SEARCH_LIMIT=20
MEMORY_TIMEOUT_SECONDS=2
MEMORY_SERVICE_TOKEN=
