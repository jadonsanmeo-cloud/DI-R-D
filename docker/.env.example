API_PORT=8036

POSTGRES_PASSWORD=replace-with-a-long-random-password

OPENROUTER_API_KEY=replace-with-provider-key
SANDBOX_TOKEN=replace-with-axiom-sandbox-token

# Runtime configuration
MODEL_CONFIG_PATH=configs/proxy-openrouter.toml
DATA_CORPUS_ROOT=.
SANDBOX_BACKEND=axiom
REPORT_FORCE_CODE_AGENT=false

# Used only when the API runs on the host with SANDBOX_BACKEND=docker.
SANDBOX_DOCKER_IMAGE=data-intelligence-sandbox:local
SANDBOX_DOCKER_MEMORY=1g
SANDBOX_DOCKER_CPUS=1.0
SANDBOX_DOCKER_PIDS_LIMIT=128
SANDBOX_DOCKER_WORKSPACE_SIZE=512m
