API_PORT=8036

# Linux: set this to `id -g` when the host artifacts/ directory uses another group.
ARTIFACTS_GID=1000

OPENROUTER_API_KEY=

RUNTIME_SERVICE_TOKEN=
GEN_REPORT_API_URL=http://host.docker.internal:8011

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="data-intelligence"
# US cloud is the default. Set LANGSMITH_ENDPOINT only for another region.
# LANGSMITH_ENDPOINT="https://eu.api.smith.langchain.com"

# AXIOM Memory Platform recall. Completed-turn capture is owned upstream.
MEMORY_ENABLED=true
MEMORY_SERVICE_URL=http://host.docker.internal:8005
MEMORY_TENANT_ID=test-org
MEMORY_DEFAULT_USER_ID=local-dev-user
MEMORY_SEARCH_LIMIT=20
MEMORY_TIMEOUT_SECONDS=2
MEMORY_SERVICE_TOKEN=

# Hermes-style curated USER.md + MEMORY.md and session-recall APIs.
# This is disabled by default; enable only when Intelligence Service is reachable.
INTERNAL_MEMORY_ENABLED=false
INTERNAL_MEMORY_SERVICE_URL=http://host.docker.internal:8006/api/v1
