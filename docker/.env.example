API_PORT=8036

POSTGRES_DB=data_intelligence
POSTGRES_USER=data_intelligence
POSTGRES_PASSWORD=data_intelligence

OPENROUTER_API_KEY=

# Use a host address that AXIOM service containers can resolve when mirroring
# generated report artifacts into AXIOM-owned object storage.
GEN_REPORT_API_URL=http://host.docker.internal:8011
GEN_REPORT_PUBLIC_URL=http://host.docker.internal:8011

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT="data-intelligence"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
