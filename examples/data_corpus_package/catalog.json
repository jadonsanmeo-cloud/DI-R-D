      "raw/txt/customer_segments.txt",
      "raw/txt/product_catalog.txt",
      "raw/txt/support_notes.txt",
      "raw/txt/web_activity.txt"
    ]
  },
  "embedding": {
    "environment_variable": "OPENROUTER_EMBEDDING_MODEL",
    "default_model": "openai/text-embedding-3-small",
