      "engine": "postgres",
      "description": "Mock Postgres order records with customer, country, status, and revenue fields."
    },
    {
      "name": "document_chunks",
      "kind": "vectordb_collection",
      "source": "postgresql://data_intelligence:data_intelligence@localhost:2345/data_corpus?schema=vectordb",
      "raw_files": [
        "raw/txt/orders_summary.txt",
        "raw/txt/customer_segments.txt",
        "raw/txt/product_catalog.txt",
        "raw/txt/support_notes.txt",
        "raw/txt/web_activity.txt"
      ],
      "description": "Persisted document chunks containing chunk ids, source document ids, text content, mock embeddings, and metadata for semantic retrieval."
    }
  ],
  "summary": "A mock data corpus package with five CSV files persisted into Postgres tables and five TXT files chunked into pgvector-backed document embeddings."
}
