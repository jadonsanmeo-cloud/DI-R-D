# Model provider
OPENROUTER_API_KEY=
LLM_MODEL_NAME=
EMBEDDING_MODEL_NAME=
MODEL_CONFIG_PATH=configs/proxy-openrouter.toml

# Host API
DATA_CORPUS_ROOT=.
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PIPELINE_TIMEOUT_SECONDS=300

# Request-scoped local sandbox
SANDBOX_ENABLED=true
SANDBOX_BACKEND=docker
SANDBOX_DOCKER_IMAGE=data-intelligence-sandbox:local
SANDBOX_DOCKER_MEMORY=1g
SANDBOX_DOCKER_CPUS=1.0
SANDBOX_DOCKER_PIDS_LIMIT=128
SANDBOX_DOCKER_WORKSPACE_SIZE=512m

# Set true only when explicitly testing the generated-code route.
REPORT_FORCE_CODE_AGENT=false
